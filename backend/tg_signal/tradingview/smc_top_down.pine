//@version=5
// SMC Top-Down XAUUSD — bias EMA50 H1 · POI M15 (FVG/OB/IFVG) · CHoCH M5 · entry FVG M5 / market · RR 1:3
// Port dari backend/tg_signal/pro_strategy.py (konfigurasi pro_live). Pasang di chart XAUUSD M5.
// Catatan: harga chart = BID, spread tidak dihitung; filter news tidak ada (cek kalender manual).
indicator("SMC Top-Down XAUUSD", shorttitle = "SMC-TD", overlay = true, max_boxes_count = 500,
     max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ───────── Input ─────────
emaLen    = input.int(50, "EMA bias H1")
slopeMin  = input.float(0.1, "Kemiringan EMA min (× ATR H1 per 3 bar)", step = 0.05)
atrLen    = input.int(14, "ATR H1 (rata-rata high-low)")
minPb     = input.float(1.0, "Pullback min (× ATR H1), 0 = off", step = 0.1)
pbLook    = input.int(48, "Lookback pullback (bar M5)")
poiMin    = input.float(0.5, "Ukuran POI min ($)", step = 0.1)
poiAge    = input.int(864, "Umur POI maks (bar M5, 864 = 3 hari)")
armWait   = input.int(36, "Tunggu CHoCH maks (bar M5)")
pendWait  = input.int(12, "Masa berlaku limit (bar M5)")
slBuf     = input.float(0.3, "Buffer SL ($)", step = 0.1)
riskMin   = input.float(1.0, "Risiko min ($)")
riskMax   = input.float(10.0, "Risiko maks ($)")
rr        = input.float(3.0, "RR")
maxTrDay  = input.int(3, "Maks trade/hari/arah")
maxLsDay  = input.int(2, "Stop setelah N loss/hari/arah")
zoneMode  = input.string("Terdekat", "Tampilan POI M15", options = ["Terdekat", "Semua", "Off"],
     tooltip = "Terdekat = hanya N zona aktif (belum dipakai) paling dekat harga, searah bias H1. Semua = seluruh riwayat zona. Logika sinyal tidak berubah.")
zoneN     = input.int(3, "Jumlah zona terdekat per arah", minval = 1, maxval = 20)
zoneBias  = input.bool(true, "Mode Terdekat: hanya arah bias H1")
showZones = zoneMode == "Semua"
showBias  = input.bool(true, "Warna latar bias H1")
posW      = input.int(12, "Lebar penanda posisi (bar)", minval = 3)
showStats = input.bool(true, "Tabel statistik")

// ───────── Data HTF (tanpa repaint: hanya bar yang sudah close) ─────────
f_h1() =>
    e = ta.ema(close, emaLen)
    a = ta.sma(high - low, atrLen)
    [close[1], e[1], e[4], a[1]]
[h1c, h1e, h1e3, h1atr] = request.security(syminfo.tickerid, "60", f_h1(), lookahead = barmerge.lookahead_on)
biasUp = h1c > h1e and (h1e - h1e3) > slopeMin * h1atr
biasDn = h1c < h1e and (h1e - h1e3) < -slopeMin * h1atr

f_m15() =>
    [open[1], high[1], low[1], close[1]]
[qo, qh, ql, qc] = request.security(syminfo.tickerid, "15", f_m15(), lookahead = barmerge.lookahead_on)
newQ   = timeframe.change("15")
dayW   = dayofmonth(time, "Asia/Jakarta")
newDay = dayW != dayW[1]

plot(h1e, "EMA50 H1", color = biasUp ? color.teal : biasDn ? color.red : color.gray, linewidth = 2, style = plot.style_stepline)
bgcolor(showBias ? (biasUp ? color.new(color.teal, 93) : biasDn ? color.new(color.red, 93) : na) : na)

// ───────── Tipe ─────────
type Zone
    float top
    float bot
    string kind
    int ci
    bool used = false
    box bx

type Cand
    float top
    float bot
    int qi

type St
    int side
    string state = "idle"
    Zone poi
    int armI = 0
    float lowP = 0.0
    int lowI = 0
    float lim = 0.0
    float sl = 0.0
    float tp = 0.0
    float entry = 0.0
    float risk = 0.0
    int pendUntil = 0
    int entryI = 0
    bool isLimit = false
    int nDay = 0
    int lossDay = 0
    int trades = 0
    int wins = 0
    float sumR = 0.0
    array<int> shI
    array<float> shP
    int xS = 0
    box bT
    box bS
    label tE
    label tS
    label tT

// Semua logika dihitung di "ruang BUY": untuk SELL harga dinegasikan (high ↔ -low).
var array<float> QO = array.new<float>()
var array<float> QH = array.new<float>()
var array<float> QL = array.new<float>()
var array<float> QC = array.new<float>()
var int qN = 0
var array<Zone> zB = array.new<Zone>()
var array<Zone> zS = array.new<Zone>()
var array<Cand> cB = array.new<Cand>()
var array<Cand> cS = array.new<Cand>()
var St stB = St.new(side = 1, shI = array.new<int>(), shP = array.new<float>())
var St stS = St.new(side = -1, shI = array.new<int>(), shP = array.new<float>())

qO(int s, int b) => s * array.get(QO, array.size(QO) - 1 - b)
qC(int s, int b) => s * array.get(QC, array.size(QC) - 1 - b)
qH(int s, int b) => s > 0 ? array.get(QH, array.size(QH) - 1 - b) : -array.get(QL, array.size(QL) - 1 - b)
qL(int s, int b) => s > 0 ? array.get(QL, array.size(QL) - 1 - b) : -array.get(QH, array.size(QH) - 1 - b)
hAt(int s, int off) => s > 0 ? high[off] : -low[off]
lAt(int s, int off) => s > 0 ? low[off] : -high[off]

f_box(int s, float top, float bot, string kind) =>
    box bx = na
    if showZones
        col = s > 0 ? color.teal : color.red
        bx := box.new(bar_index - 3, s > 0 ? top : -bot, bar_index, s > 0 ? bot : -top,
             border_color = color.new(col, 60), bgcolor = color.new(col, 85), extend = extend.right,
             text = kind, text_size = size.tiny, text_color = color.new(col, 30), text_halign = text.align_left)
    bx

f_endBox(Zone z) =>
    if not na(z.bx)
        box.set_extend(z.bx, extend.none)
        box.set_right(z.bx, bar_index - 1)
    true

f_newZone(int s, array<Zone> zs, float top, float bot, string kind) =>
    array.push(zs, Zone.new(top, bot, kind, bar_index - 1, false, f_box(s, top, bot, kind)))
    if array.size(zs) > 80
        f_endBox(array.shift(zs))
    true

// Dipanggil saat satu bar M15 baru selesai.
f_m15Update(int s, array<Zone> zs, array<Cand> cs) =>
    c0 = qC(s, 0)
    n = array.size(QC)
    // 1) zona mati: close M15 menembus sisi distal, atau kadaluarsa
    if array.size(zs) > 0
        for idx = array.size(zs) - 1 to 0
            z = array.get(zs, idx)
            if c0 < z.bot or bar_index - z.ci > poiAge
                f_endBox(z)
                array.remove(zs, idx)
    // 2) FVG berlawanan yang ditembus close → IFVG
    if array.size(cs) > 0
        for idx = array.size(cs) - 1 to 0
            cd = array.get(cs, idx)
            if c0 > cd.top
                f_newZone(s, zs, cd.top, cd.bot, "IFVG")
                array.remove(cs, idx)
            else if qN - cd.qi > 600
                array.remove(cs, idx)
    // 3) FVG + OB baru, kandidat IFVG baru
    if n >= 3
        if qL(s, 0) - qH(s, 2) >= poiMin
            f_newZone(s, zs, qL(s, 0), qH(s, 2), "FVG")
            found = false
            for b = 2 to 4
                if not found and n > b
                    if qC(s, b) < qO(s, b)
                        found := true
                        if qO(s, b) - qL(s, b) >= poiMin
                            f_newZone(s, zs, qO(s, b), qL(s, b), "OB")
        if qL(s, 2) - qH(s, 0) >= poiMin
            array.push(cs, Cand.new(qL(s, 2), qH(s, 0), qN))
            if array.size(cs) > 200
                array.shift(cs)
    true

f_frac(St st) =>
    s = st.side
    v = hAt(s, 2)
    mx = math.max(hAt(s, 0), hAt(s, 1), hAt(s, 2), hAt(s, 3), hAt(s, 4))
    if v >= mx
        array.push(st.shI, bar_index - 2)
        array.push(st.shP, v)
        if array.size(st.shI) > 300
            array.shift(st.shI)
            array.shift(st.shP)
    true

fmtP(float v) => str.tostring(v, "#.00")

// Penanda posisi: kotak hijau entry→TP, kotak merah entry→SL, label harga di ujung kanan.
f_lines(St st, float e, string txt) =>
    s = st.side
    x1 = bar_index
    x2 = bar_index + posW
    st.xS := bar_index
    yE = s * e
    yS = s * st.sl
    yT = s * st.tp
    st.bT := box.new(x1, math.max(yE, yT), x2, math.min(yE, yT), border_color = color.new(color.green, 30),
         bgcolor = color.new(color.green, 82))
    st.bS := box.new(x1, math.max(yE, yS), x2, math.min(yE, yS), border_color = color.new(color.red, 30),
         bgcolor = color.new(color.red, 82))
    st.tE := label.new(x2, yE, txt + " " + fmtP(yE), style = label.style_label_left, color = color.blue,
         textcolor = color.white, size = size.small)
    st.tS := label.new(x2, yS, "SL " + fmtP(yS) + "  (-" + str.tostring(math.round(st.risk / 0.1)) + " pips)",
         style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small)
    st.tT := label.new(x2, yT, "TP " + fmtP(yT) + "  (+" + str.tostring(math.round(rr * st.risk / 0.1)) + " pips, " + str.tostring(rr) + "R)",
         style = label.style_label_left, color = color.green, textcolor = color.white, size = size.small)

// Selama pending/open: kotak & label ikut bergeser ke kanan.
f_follow(St st) =>
    if st.state == "pending" or st.state == "open"
        x2 = bar_index + posW
        if not na(st.bT)
            box.set_right(st.bT, x2)
            box.set_right(st.bS, x2)
            label.set_x(st.tE, x2)
            label.set_x(st.tS, x2)
            label.set_x(st.tT, x2)
    true

f_endLines(St st, bool cancelled) =>
    if not na(st.bT)
        xe = math.max(bar_index, st.xS + 3)      // minimal 3 bar supaya tetap terlihat (SL di bar entry)
        box.set_right(st.bT, xe)
        box.set_right(st.bS, xe)
        label.set_x(st.tE, xe)
        label.set_x(st.tS, xe)
        label.set_x(st.tT, xe)
        if cancelled
            box.set_bgcolor(st.bT, color.new(color.gray, 88))
            box.set_bgcolor(st.bS, color.new(color.gray, 88))
            box.set_border_color(st.bT, color.new(color.gray, 50))
            box.set_border_color(st.bS, color.new(color.gray, 50))
            label.set_text(st.tE, label.get_text(st.tE) + "  (batal, tidak terisi)")
            label.set_color(st.tE, color.gray)
            label.set_color(st.tS, color.new(color.gray, 30))
            label.set_color(st.tT, color.new(color.gray, 30))
    st.bT := na
    st.bS := na
    st.tE := na
    st.tS := na
    st.tT := na

f_close(St st, float r, string why) =>
    s = st.side
    st.state := "idle"
    st.trades += 1
    st.sumR += r
    if r > 0
        st.wins += 1
    if r < 0
        st.lossDay += 1
    label.new(bar_index, s > 0 ? high : low, why + " " + str.tostring(r, "#.##") + "R",
         style = s > 0 ? label.style_label_down : label.style_label_up,
         color = r > 0 ? color.green : color.red, textcolor = color.white, size = size.tiny)
    f_endLines(st, false)

f_skipTxt(float risk, bool canTrade) =>
    not canTrade ? "skip: batas harian (3 trade / 2 loss)" : risk < riskMin ? "skip: SL < " + str.tostring(math.round(riskMin / 0.1)) + " pips" : "skip: SL > " + str.tostring(math.round(riskMax / 0.1)) + " pips (" + str.tostring(math.round(risk / 0.1)) + ")"

f_mark(St st, float price, string txt, color col) =>
    s = st.side
    label.new(bar_index, s * price, txt, style = s > 0 ? label.style_label_up : label.style_label_down,
         color = col, textcolor = color.white, size = size.small)

f_step(St st, array<Zone> zs, bool bias, float atr) =>
    s = st.side
    i = bar_index
    dirTxt = s > 0 ? "BUY" : "SELL"
    O = s * open
    H = hAt(s, 0)
    L = lAt(s, 0)
    C = s * close
    C1 = s * close[1]
    canTrade = st.nDay < maxTrDay and st.lossDay < maxLsDay

    // entry market di open bar sesudah CHoCH
    if st.state == "mkt"
        risk = O - st.sl
        if risk >= riskMin and risk <= riskMax and canTrade
            st.entry := O
            st.risk := risk
            st.tp := O + rr * risk
            st.entryI := i
            st.isLimit := false
            st.nDay += 1
            st.state := "open"
            f_lines(st, O, dirTxt + " MARKET @")
        else
            st.state := "idle"
            f_mark(st, st.lowP, f_skipTxt(risk, canTrade), color.new(color.gray, 20))

    if st.state == "open"
        if not (i == st.entryI and st.isLimit)
            if L <= st.sl
                f_close(st, (st.sl - st.entry) / st.risk, "SL")
            else if H >= st.tp
                f_close(st, rr, "TP")
    else if st.state == "pending"
        if L <= st.lim
            st.entry := math.min(st.lim, O)
            st.entryI := i
            st.isLimit := true
            st.nDay += 1
            st.state := "open"
            if not na(st.tE)
                label.set_text(st.tE, dirTxt + " FILL @ " + fmtP(s * st.entry))
            if L <= st.sl
                f_close(st, (st.sl - st.entry) / st.risk, "SL")
        else if H >= st.tp or L <= st.sl or i > st.pendUntil
            st.state := "idle"
            f_endLines(st, true)
    else if st.state == "armed"
        p = st.poi
        if C < p.bot or i - st.armI > armWait
            st.state := "idle"
        else
            if L < st.lowP
                st.lowP := L
                st.lowI := i
            loI = st.lowI
            // swing high M5 terakhir (sudah terkonfirmasi) sebelum low terendah
            lim0 = math.max(st.armI - 40, 2)
            float lvl = na
            sz = array.size(st.shI)
            if sz > 0
                for q = sz - 1 to 0
                    ki = array.get(st.shI, q)
                    if ki <= lim0
                        break
                    if ki < loI
                        lvl := array.get(st.shP, q)
                        break
            if na(lvl)
                k0 = math.max(0, st.armI - 6)
                for kk = k0 to st.armI
                    hv = hAt(s, i - kk)
                    lvl := na(lvl) ? hv : math.max(lvl, hv)
            if i > loI and C > lvl
                f_mark(st, lvl, "CHoCH", color.new(color.orange, 20))
                ok = true
                if minPb > 0
                    w0 = math.max(0, i - pbLook)
                    float hmax = na
                    hiI = i
                    for kk = w0 to i
                        hv = hAt(s, i - kk)
                        if na(hmax) or hv > hmax
                            hmax := hv
                            hiI := kk
                    float lmin = na
                    for kk = hiI to i
                        lv = lAt(s, i - kk)
                        lmin := na(lmin) ? lv : math.min(lmin, lv)
                    if not (hmax - lmin >= minPb * atr)
                        ok := false
                        st.state := "idle"
                        f_mark(st, st.lowP, "skip: pullback dangkal", color.new(color.gray, 20))
                if ok
                    sl = st.lowP - slBuf
                    float lim = na
                    if i >= loI + 2
                        for kk = i to loI + 2
                            if lAt(s, i - kk) > hAt(s, i - kk + 2)
                                lim := lAt(s, i - kk)
                                break
                    if not na(lim)
                        risk = lim - sl
                        if risk >= riskMin and risk <= riskMax and canTrade
                            st.lim := lim
                            st.sl := sl
                            st.risk := risk
                            st.tp := lim + rr * risk
                            st.pendUntil := i + pendWait
                            st.state := "pending"
                            f_lines(st, lim, dirTxt + " LIMIT")
                            txt = dirTxt + " LIMIT " + str.tostring(s * lim, "#.00") + "\nSL " + str.tostring(s * sl, "#.00") + "  TP " + str.tostring(s * st.tp, "#.00")
                            alert("SMC-TD " + syminfo.ticker + " " + txt, alert.freq_once_per_bar_close)
                        else
                            st.state := "idle"
                            f_mark(st, st.lowP, f_skipTxt(risk, canTrade), color.new(color.gray, 20))
                    else
                        st.sl := sl
                        st.state := "mkt"
                        txt = dirTxt + " MARKET (open candle berikut)\nSL " + str.tostring(s * sl, "#.00") + "  TP = 3R"
                        alert("SMC-TD " + syminfo.ticker + " " + txt, alert.freq_once_per_bar_close)
    else if st.state == "idle"
        if canTrade and bias
            Zone best = na
            for z in zs
                if not z.used and z.ci < i and i - z.ci <= poiAge and C1 > z.top and z.top >= L and C >= z.bot
                    if na(best)
                        best := z
                    else if z.top > best.top
                        best := z
            if not na(best)
                best.used := true
                if not na(best.bx)
                    box.set_bgcolor(best.bx, color.new(color.gray, 85))
                st.poi := best
                st.armI := i
                st.lowP := L
                st.lowI := i
                st.state := "armed"
    true

// ───────── Loop utama (hanya bar yang sudah close) ─────────
if barstate.isconfirmed
    if newQ and not na(qc)
        array.push(QO, qo)
        array.push(QH, qh)
        array.push(QL, ql)
        array.push(QC, qc)
        if array.size(QC) > 6
            array.shift(QO)
            array.shift(QH)
            array.shift(QL)
            array.shift(QC)
        qN += 1
        f_m15Update(1, zB, cB)
        f_m15Update(-1, zS, cS)
    if newDay
        stB.nDay := 0
        stB.lossDay := 0
        stS.nDay := 0
        stS.lossDay := 0
    if bar_index >= 4
        f_frac(stB)
        f_frac(stS)
    if bar_index > 50 and not na(h1atr)
        f_step(stB, zB, biasUp, h1atr)
        f_step(stS, zS, biasDn, h1atr)
    f_follow(stB)
    f_follow(stS)

// ───────── Mode "Terdekat": gambar ulang N zona aktif terdekat di bar terakhir ─────────
var array<box> nearBx = array.new<box>()
f_drawNear(int s, array<Zone> zs) =>
    px = s * close
    // zona aktif, belum dipakai, di bawah harga (ruang BUY): urut dari yang paling dekat
    tops = array.new<float>()
    idxs = array.new<int>()
    if array.size(zs) > 0
        for k = 0 to array.size(zs) - 1
            z = array.get(zs, k)
            if not z.used and z.top <= px and bar_index - z.ci <= poiAge
                array.push(tops, px - z.top)
                array.push(idxs, k)
    if array.size(tops) > 0
        ord = array.sort_indices(tops, order.ascending)
        cnt = math.min(zoneN, array.size(ord))
        for q = 0 to cnt - 1
            z = array.get(zs, array.get(idxs, array.get(ord, q)))
            col = s > 0 ? color.teal : color.red
            array.push(nearBx, box.new(z.ci, s > 0 ? z.top : -z.bot, bar_index + 10, s > 0 ? z.bot : -z.top,
                 border_color = color.new(col, 50), bgcolor = color.new(col, 82), text = z.kind,
                 text_size = size.tiny, text_color = color.new(col, 20), text_halign = text.align_left))
    true

if zoneMode == "Terdekat" and barstate.islast
    while array.size(nearBx) > 0
        box.delete(array.pop(nearBx))
    if not zoneBias or biasUp
        f_drawNear(1, zB)
    if not zoneBias or biasDn
        f_drawNear(-1, zS)

// ───────── Statistik di chart ─────────
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showStats and barstate.islast
    tot = stB.trades + stS.trades
    win = stB.wins + stS.wins
    table.cell(tb, 0, 0, "SMC Top-Down", text_color = color.white)
    table.cell(tb, 1, 0, timeframe.period == "5" ? "M5 ✓" : "Pakai chart M5!", text_color = timeframe.period == "5" ? color.lime : color.orange)
    table.cell(tb, 0, 1, "Bias H1", text_color = color.white)
    table.cell(tb, 1, 1, biasUp ? "BUY" : biasDn ? "SELL" : "datar / tidak ada", text_color = biasUp ? color.lime : biasDn ? color.red : color.gray)
    table.cell(tb, 0, 2, "Trade (chart)", text_color = color.white)
    table.cell(tb, 1, 2, str.tostring(tot) + "  WR " + (tot > 0 ? str.tostring(100.0 * win / tot, "#") + "%" : "-"), text_color = color.white)
    table.cell(tb, 0, 3, "Total R", text_color = color.white)
    table.cell(tb, 1, 3, str.tostring(stB.sumR + stS.sumR, "#.#") + "R  (B " + str.tostring(stB.sumR, "#.#") + " / S " + str.tostring(stS.sumR, "#.#") + ")", text_color = color.white)
    table.cell(tb, 0, 4, "Status", text_color = color.white)
    table.cell(tb, 1, 4, "BUY: " + stB.state + " | SELL: " + stS.state, text_color = color.white)
